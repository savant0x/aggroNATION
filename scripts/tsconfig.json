{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "server-only": ["./stubs/server-only.ts"],
      "@/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "../lib/**/*.ts"]
}
