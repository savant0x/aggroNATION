# Firebase (web SDK config — public identifiers, safe for client bundles)
# Find these in Firebase console > Project settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (never expose to client)
YOUTUBE_API_KEY=
CRON_SECRET=

# Admin SDK credentials — EITHER the service-account pair (production/Vercel):
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# ...OR, for local dev, run `gcloud auth application-default login` once
# (applicationDefault credentials; no env vars needed). Emulator mode also works.

# Set to true to point the client SDK at local emulators (Auth :9099, Firestore :8080)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
