rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Content is world-readable, writeable only by the server (Admin SDK bypasses rules)
    match /content/{contentId} {
      allow read: if true;
      allow write: if false;
    }

    // Sources are server-managed; readable only by admins
    match /sources/{sourceId} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Users can read and update their own profile document, never create/delete
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
